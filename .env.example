PORT=8080
# Postgres connection string. The default matches a local db/user named
# "masterwill" — create it yourself, or run `docker compose up -d db`.
DATABASE_URL=postgres://masterwill:masterwill_dev_pw@localhost:5432/masterwill?sslmode=disable

# Change this in any environment that isn't your own machine.
JWT_SECRET=dev-secret-change-me

# Bootstrap admin account, created on first run if admin_users is empty.
ADMIN_EMAIL=admin@maistervil.kyiv.ua
ADMIN_PASSWORD=admin12345

# Frontend origin allowed to call this API.
CORS_ORIGIN=http://localhost:5173

# This API's own public URL (used to build LiqPay's server_url callback).
PUBLIC_BASE_URL=http://localhost:8080
# Where to send the shopper back to after payment.
FRONTEND_URL=http://localhost:5173

# "mock" (default) marks every order paid instantly - no bank, no keys, good
# for local dev and demos. "liqpay" talks to the real LiqPay checkout API and
# requires a merchant account's keys below.
PAYMENT_PROVIDER=mock
LIQPAY_PUBLIC_KEY=
LIQPAY_PRIVATE_KEY=
